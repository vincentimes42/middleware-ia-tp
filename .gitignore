# ------------------------------------------------------------------
#  TP IA — .gitignore
# ------------------------------------------------------------------

# No Java here (it lives in the TP1 repo). `client/mcp-client.json` IS
# committed: it holds the demo account only, never the Gemini key.

# --- Secrets and local env (the Gemini key lives in the shell only) ---
.env
.env.*
*.env
*.local

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
.factorypath

# --- Logs and ad-hoc shell-redirect output (e.g. `... 2> err.txt`) ---
*.log
/err*.txt
/out*.txt

# --- OS ---
.DS_Store
Thumbs.db
